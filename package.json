{
    "name": "@vergil-astro/theme",
    "version": "1.0.2",
    "description": "Vergil: a content site theme for Astro, shipped as an Astro integration",
    "type": "module",
    "license": "MIT",
    "bin": {
        "vg": "./bin/vg.mjs"
    },
    "keywords": [
        "astro",
        "astro-integration",
        "astro-theme",
        "withastro"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/vergil-astro/vergil-astro-theme.git"
    },
    "exports": {
        ".": {
            "types": "./dist/integration.d.ts",
            "default": "./src/integration.ts"
        },
        "./collections": "./src/collections.ts",
        "./types": {
            "types": "./dist/types.d.ts",
            "default": "./src/types.ts"
        },
        "./plugins/directives/schema.mjs": "./src/plugins/directives/schema.mjs",
        "./appearance/contract.json": "./src/appearance/contract.json",
        "./package.json": "./package.json"
    },
    "files": [
        "src",
        "bin",
        "dist",
        "pnpm-workspace.yaml"
    ],
    "scripts": {
        "dev": "pnpm --dir starter dev",
        "build": "pnpm --dir starter build",
        "build:types": "tsc -p tsconfig.types.json",
        "prepack": "pnpm build:types",
        "preview": "pnpm --dir starter preview",
        "fonts:subset": "bash scripts/subset-fonts.sh",
        "samples:dates": "node scripts/refresh-sample-dates.mjs",
        "samples:dates:dry": "node scripts/refresh-sample-dates.mjs --dry"
    },
    "peerDependencies": {
        "astro": "^7.3.5"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "dependencies": {
        "@astrojs/markdown-remark": "^7.3.6",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.4",
        "@fontsource-variable/inter": "^5.3.0",
        "@iconify-json/bx": "^1.2.3",
        "@iconify-json/lucide": "^1.2.152",
        "@iconify-json/solar": "^1.2.14",
        "@lucide/astro": "^1.70.0",
        "@rive-app/canvas": "^2.49.4",
        "@shikijs/transformers": "^4.6.0",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.5",
        "@vergil-astro/vergil-cli": "^0.2.1",
        "echarts": "^6.1.0",
        "fuse.js": "^7.5.0",
        "hastscript": "^9.0.3",
        "katex": "^0.17.0",
        "lunar-javascript": "^1.7.8",
        "marked": "^18.1.3",
        "medium-zoom": "^1.1.2",
        "mermaid": "^12.3.0",
        "node-html-parser": "^9.0.7",
        "open-props": "^1.7.23",
        "qrcode-svg": "^1.1.0",
        "rehype-katex": "^7.0.1",
        "rehype-mathjax": "^7.1.0",
        "remark": "^15.0.1",
        "remark-directive": "^4.0.0",
        "remark-math": "^6.0.0",
        "sql-formatter": "^15.9.0",
        "tailwindcss": "^4.3.5",
        "unist-util-visit": "^5.2.0"
    },
    "devDependencies": {
        "astro": "^7.4.7",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-tailwindcss": "^0.7.4",
        "typescript": "^7.0.2"
    }
}
