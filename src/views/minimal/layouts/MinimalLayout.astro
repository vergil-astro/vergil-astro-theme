---
import { locale, t } from '../../../i18n';
import { skin, defaultScheme } from '../../../utils/skin';
import { ViewTransitions } from 'astro:transitions';
import { ChevronLeft } from '@lucide/astro';
import BaseHead, { type Props as HeadProps } from '../../../components/base/BaseHead.astro';
import ThemeToggle from '../../../components/ui/ThemeToggle.astro';

export type Props = HeadProps & {
    showBackLink?: string;
    backHref?: string;
    showBreadcrumb?: boolean;
};

const { showBackLink, backHref, showBreadcrumb = false, ...head } = Astro.props;
const isArticle = head.pageType === 'article';
---

<!doctype html>
<html lang={locale} data-skin={skin} data-default-scheme={defaultScheme} class="wrap-break-words antialiased">
    <head>
        <BaseHead {...head} />
        <script is:inline>
            (function() {
                try {
                    var scheme = localStorage.getItem('colorScheme') || document.documentElement.getAttribute('data-default-scheme') || 'C';
                    var isDark = localStorage.getItem('darkMode');
                    document.documentElement.setAttribute('data-theme', scheme);
                    if (isDark === 'true' || (isDark === null && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                        document.documentElement.classList.add('dark');
                    }
                } catch(e) {}
            })();
        </script>
        <ViewTransitions />
        <script>
            import '../../../scripts/theme-toggle.js';
        </script>
        <meta name="robots" content="noindex" />
    </head>
    <body class="bg-main text-main">
        <a class="skip-link" href="#main-content">{t.a11y.skipToContent}</a>
        {isArticle && (
            <div id="reading-progress" data-progress="page" class="fixed top-0 left-0 h-[2px] w-full origin-left bg-accent z-[60] transition-none" style="transform: scaleX(0)"></div>
        )}

        <main id="main-content" class="min-h-screen flex flex-col">
            <div class="flex-1 w-full max-w-3xl mx-auto px-6 pt-12 pb-20">
                <!-- 顶部栏：返回链接 + ThemeToggle -->
                <div class="flex items-center justify-between mb-6">
                    {showBackLink ? (
                        <a href={backHref} class="text-sm text-secondary hover:text-accent transition-colors inline-flex items-center gap-1">
                            <ChevronLeft class="w-3.5 h-3.5" /> {showBackLink}
                        </a>
                    ) : (
                        <div />
                    )}
                    <ThemeToggle />
                </div>

                <!-- 面包屑插槽 -->
                {showBreadcrumb && (
                    <div id="minimal-breadcrumb" class="mb-6">
                        <slot name="breadcrumb" />
                    </div>
                )}

                <slot />
            </div>
        </main>

        <button
            id="minimal-back-to-top"
            class="ui-fab floating-slot-1 fixed right-4 xl:right-6 z-50 flex items-center justify-center w-10 h-10 bg-card/90 backdrop-blur-sm border border-light/60 rounded-full shadow-lg text-secondary hover:text-accent hover:border-accent/40 hover:shadow-md hover:scale-[1.04] transition-[transform,box-shadow,color,border-color] duration-150 opacity-0 invisible translate-y-3"
            aria-label={t.nav.backToTop}
            title={t.nav.backToTop}
        >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
            </svg>
        </button>

        <div class="fixed bottom-6 left-0 right-0 flex justify-center z-50 pointer-events-none">
            <button
                id="minimal-back-btn"
                class="px-4 py-2 rounded-full bg-card/90 backdrop-blur-sm border border-light/60 shadow-lg text-sm text-secondary hover:text-accent hover:border-accent/40 hover:shadow-md hover:scale-[1.04] transition-[transform,box-shadow,color,border-color] duration-150 cursor-pointer pointer-events-auto"
            >
                {t.common.back}
            </button>
        </div>
        <script is:inline>
            (function(){
                document.addEventListener('click', function(e){
                    var btn = e.target.closest('#minimal-back-btn');
                    if(!btn) return;
                    if(history.length > 1){
                        history.back();
                    } else {
                        location.href = '/';
                    }
                });

                function initBackToTop() {
                    var btn = document.getElementById('minimal-back-to-top');
                    if (!btn || btn.__bttInit) return;
                    btn.__bttInit = true;

                    var ticking = false;
                    function update() {
                        if (window.scrollY > 400) {
                            btn.classList.remove('opacity-0', 'invisible', 'translate-y-3');
                            btn.classList.add('opacity-100', 'visible', 'translate-y-0');
                        } else {
                            btn.classList.add('opacity-0', 'invisible', 'translate-y-3');
                            btn.classList.remove('opacity-100', 'visible', 'translate-y-0');
                        }
                        ticking = false;
                    }
                    window.addEventListener('scroll', function() {
                        if (!ticking) {
                            requestAnimationFrame(update);
                            ticking = true;
                        }
                    }, { passive: true });
                    btn.addEventListener('click', function() {
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    });
                    update();
                }
                document.addEventListener('astro:page-load', initBackToTop);
                initBackToTop();
            })();
        </script>

        {isArticle && (
            <script is:inline>
                (function () {
                    // 这段脚本在无刷新切换页面后还会再跑。上一次绑定的监听记在 window 上，先解绑再绑，否则每切换一次就多一个监听。
                    // 三个布局各有一份进度条脚本，data-progress 标明当前页面用的是哪一份。进度用 transform 缩放，不改宽度，滚动时不触发布局
                    function initProgress() {
                        if (window.__vergilProgressMinimal) {
                            window.removeEventListener('scroll', window.__vergilProgressMinimal);
                            window.__vergilProgressMinimal = null;
                        }
                        var bar = document.getElementById('reading-progress');
                        if (!bar || bar.dataset.progress !== 'page') return;
                        var ticking = false;
                        function update() {
                            ticking = false;
                            var docHeight = document.documentElement.scrollHeight - window.innerHeight;
                            var ratio = docHeight > 0 ? Math.min(1, Math.max(0, window.scrollY / docHeight)) : 0;
                            bar.style.transform = 'scaleX(' + ratio + ')';
                        }
                        function onScroll() {
                            if (!ticking) {
                                ticking = true;
                                requestAnimationFrame(update);
                            }
                        }
                        window.__vergilProgressMinimal = onScroll;
                        window.addEventListener('scroll', onScroll, { passive: true });
                        update();
                    }
                    if (!window.__vergilProgressMinimalInit) {
                        window.__vergilProgressMinimalInit = true;
                        document.addEventListener('astro:page-load', initProgress);
                    }
                    initProgress();
                })();
            </script>
        )}
    </body>
</html>
