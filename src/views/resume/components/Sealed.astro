---
/**
 * A block of the resume that needs encryption. With password, its content is rendered to HTML and then encrypted, leaving only ciphertext in the page;
 * after unlocking, src/views/resume/scripts/resume-vault.ts swaps it back as-is. Without password, the content is output directly
 */
import { seal } from '../../../utils/resume-crypto';

interface Props {
    password?: string;
}

const { password } = Astro.props;
const sealed = password ? await seal(await Astro.slots.render('default'), password) : null;
---

{
    sealed ? (
        <div
            data-sealed
            data-salt={sealed.salt}
            data-iv={sealed.iv}
            data-iter={sealed.iter}
            data-ciphertext={sealed.ciphertext}
        />
    ) : (
        <slot />
    )
}
