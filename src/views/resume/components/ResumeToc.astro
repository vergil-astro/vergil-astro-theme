---
/** Resume table of contents: a row of section anchors (## headings) in the middle of the top toolbar, hidden on narrow screens and in print */
import { t } from '../../../i18n';

interface Props {
    headings: { depth: number; slug: string; text: string }[];
}

const sections = Astro.props.headings.filter((h) => h.depth === 2);
---

{
    sections.length > 0 && (
        <nav class="resume-toc" aria-label={t.page.resume.toc}>
            <ul class="flex items-center gap-5">
                {sections.map((h) => (
                    <li>
                        <a href={`#${h.slug}`} class="whitespace-nowrap text-xs text-secondary transition-colors hover:text-accent">
                            {h.text}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    )
}
