---
import { locale, t } from '../../../i18n';
import { defaultSkin } from '../../../utils/skin';
import { ClientRouter } from 'astro:transitions';
import { ChevronLeft, Printer } from '@lucide/astro';
import BaseHead, { type Props as HeadProps } from '../../../components/base/BaseHead.astro';
import ThemeInit from '../../../components/base/ThemeInit.astro';
import ResumeProfile from '../components/ResumeProfile.astro';
import ResumeToc from '../components/ResumeToc.astro';
import ResumeLock from '../components/ResumeLock.astro';
import ResumeShare from '../components/ResumeShare.astro';
import Sealed from '../components/Sealed.astro';
import ThemeToggle from '../../../components/ui/ThemeToggle.astro';
import { redactSections } from '../../../utils/resume-preview';

export type Props = HeadProps & {
    resume: import('astro:content').CollectionEntry<'resume'>;
    headings: { depth: number; slug: string; text: string }[];
};

const { resume, headings, ...head } = Astro.props;
// If the resume sets password, encrypt it: the profile, table of contents and body are output only as ciphertext, and the lock screen shows first
const { password } = resume.data;
// If preview is also configured when encrypted, generate a separate redacted version: hidden content is removed at build time, and visitors without the password can view this version first
const preview = password ? resume.data.preview : undefined;
const previewHtml = preview ? redactSections(await Astro.slots.render('default'), preview.redact, t.page.resume.redacted) : null;
---

<!doctype html>
<html lang={locale} data-skin={defaultSkin} class="wrap-break-words antialiased">
    <head>
        <BaseHead {...head} />
        <ThemeInit />
        <ClientRouter />
        <script>
            import '../../../scripts/theme-toggle.js';
            import '../scripts/resume-vault';
        </script>
        <meta name="robots" content="noindex" />
    </head>
    {/* While an encrypted resume is locked, only the lock screen shows and the toolbar and paper are hidden; resume-vault.ts removes data-resume-locked after unlocking */}
    <body class="bg-main text-main" data-resume-locked={password ? '' : undefined}>
        <a class="skip-link" href="#main-content">{t.a11y.skipToContent}</a>

        {/* Thin top toolbar: back to site on the left, table of contents in the middle, share, print and appearance on the right */}
        <div class="resume-toolbar sticky top-0 z-40 border-b border-light bg-main/85 backdrop-blur print:hidden">
            <div class="mx-auto flex h-12 max-w-[68rem] items-center justify-between gap-6 px-4 sm:px-6">
                <a href="/" class="inline-flex shrink-0 items-center gap-1 text-xs text-muted transition-colors hover:text-accent">
                    <ChevronLeft class="h-3.5 w-3.5" />
                    <span>{t.page.resume.backToSite}</span>
                </a>
                <div class="hidden min-w-0 flex-1 justify-center md:flex">
                    <Sealed password={password}>
                        <ResumeToc headings={headings} />
                    </Sealed>
                    {preview && (
                        <div data-resume-preview hidden>
                            <ResumeToc headings={headings} />
                        </div>
                    )}
                </div>
                <div class="flex shrink-0 items-center gap-1">
                    <ResumeShare sealed={Boolean(password)} />
                    <button
                        type="button"
                        onclick="window.print()"
                        class="resume-print flex h-7 w-7 cursor-pointer items-center justify-center rounded-full text-accent transition-all duration-200 hover:bg-card hover:shadow-sm"
                        aria-label={t.page.resume.print}
                        title={t.page.resume.print}
                    >
                        <Printer class="h-4 w-4" />
                    </button>
                    <ThemeToggle />
                </div>
            </div>
        </div>

        <main id="main-content" class="pb-16 sm:px-6 sm:pt-10 print:p-0">
            {password && <ResumeLock preview={Boolean(preview)} />}

            {preview && (
                <div data-resume-preview hidden class="mx-auto mb-4 max-w-[68rem] px-4 pt-4 sm:px-0 sm:pt-0">
                    <div class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-light bg-card px-4 py-2.5 text-sm text-secondary">
                        <span>{t.page.resume.previewNotice}</span>
                        <button type="button" data-resume-preview-exit class="cursor-pointer font-medium text-accent hover:opacity-80">
                            {t.page.resume.previewUnlock}
                        </button>
                    </div>
                </div>
            )}

            {/*
              One sheet of paper, two columns on wide screens: profile on the left (sticky while scrolling), body on the right; on phones the profile sits above the body.
              The paper uses overflow-clip to clip its rounded corners: overflow-hidden would make the paper a scroll container, and the left column's sticky would stop following the page scroll
            */}
            <div class="resume-frame mx-auto max-w-[68rem]">
                <div data-resume-title={resume.data.title} class="resume-paper overflow-clip bg-card sm:rounded-2xl sm:border sm:border-light sm:shadow-sm md:grid md:grid-cols-[16.5rem_minmax(0,1fr)]">
                    <aside class="resume-side border-b border-light bg-muted/50 px-6 py-8 md:border-b-0 md:border-r">
                        <div class="md:sticky md:top-20">
                            <Sealed password={password}>
                                <ResumeProfile resume={resume} />
                            </Sealed>
                            {preview && (
                                <div data-resume-preview hidden>
                                    <ResumeProfile resume={resume} masked={preview.hide} />
                                </div>
                            )}
                        </div>
                    </aside>
                    <article class="resume-main min-w-0 px-5 py-8 sm:px-10 sm:py-10">
                        <div class="resume-article prose max-w-none">
                            <Sealed password={password}>
                                <slot />
                            </Sealed>
                        </div>
                        {/* The redacted version is a sibling of the body and reuses the body's typography directly */}
                        {previewHtml && <div data-resume-preview hidden class="resume-article prose max-w-none" set:html={previewHtml} />}
                    </article>
                </div>
            </div>
        </main>

        <style is:global>
            body[data-resume-locked] .resume-toolbar,
            body[data-resume-locked] .resume-frame {
                display: none;
            }

            /* No sharing or printing in preview */
            body[data-resume-mode='preview'] :is(#resume-share, .resume-print) {
                display: none;
            }
            /* Redaction bars: cover company, job title and school; clicking one returns to the password screen */
            .resume-redact {
                display: inline-block;
                height: 0.95em;
                border-radius: 2px;
                background: var(--text-main);
                opacity: 0.82;
                vertical-align: -0.1em;
            }
            .resume-redact-sep {
                margin: 0 0.45em;
                color: var(--text-muted);
            }
            body[data-resume-mode='preview'] :is(.resume-redacted, .resume-masked) {
                cursor: pointer;
            }

            /* The resume uses a sans-serif font rather than the blog body font; to change it, set --resume-font in the site styles */
            .resume-paper,
            .resume-toc {
                font-family: var(--resume-font, ui-sans-serif, -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Sans SC', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif);
            }
            /* .prose and headings carry the blog's body and heading fonts; make them all follow the paper here */
            .resume-paper .prose,
            .resume-paper :is(h1, h2, h3, h4, strong) {
                font-family: inherit;
            }


            /*
             * Resume body. Markdown conventions: ## is a section (work experience, open source contributions…), ### is one role or project,
             * and the line right after ### that holds only one italic run is the date range (*2022.05 - 2024.09*).
             * All spacing goes on margin-top only: on wide screens the body is a grid (the date shares a row with the heading), and margins inside a grid do not collapse
             */
            .resume-article {
                font-size: 0.975rem;
                line-height: 1.7;
                /* .prose defaults to overflow-x: auto, which clips the last digit slightly when the date hugs the right edge */
                overflow: visible;
            }
            /* Resume headings do not need the hover anchor icon, which also makes the heading row taller */
            .resume-article .heading-anchor {
                display: none;
            }
            .resume-article > * {
                margin-top: 0.6em;
                margin-bottom: 0;
            }
            .resume-article > h2 {
                display: flex;
                align-items: center;
                gap: 0.55em;
                margin-top: 2.2em;
                color: var(--text-main);
                font-size: 1.05em;
                font-weight: 700;
                letter-spacing: 0.06em;
                scroll-margin-top: 4.5rem;
            }
            /* A short accent-colored bar before section headings */
            .resume-article > h2::before {
                content: '';
                width: 4px;
                height: 1em;
                border-radius: 2px;
                background: var(--accent-color);
            }
            .resume-article > :first-child {
                margin-top: 0;
            }
            .resume-article > h2 + * {
                margin-top: 0.9em;
            }
            .resume-article > h3 {
                margin-top: 1.4em;
                font-size: 1em;
                font-weight: 600;
            }
            .resume-article > h2 + h3 {
                margin-top: 0.9em;
            }
            .resume-article > h3 + p:has(> em:only-child) {
                margin-top: 0.1em;
                color: var(--text-muted);
                font-size: 0.875em;
            }
            .resume-article > h3 + p:has(> em:only-child) em {
                font-style: normal;
                font-variant-numeric: tabular-nums;
            }
            .resume-article > p:has(> em:only-child) + ul,
            .resume-article > h3 + ul {
                margin-top: 0.35em;
            }
            .resume-article > ul + p {
                margin-top: 0.5em;
                color: var(--text-secondary);
                font-size: 0.875em;
            }
            .resume-article ul {
                padding-left: 1.1em;
            }
            .resume-article ul > li {
                margin-top: 0.2em;
                margin-bottom: 0;
                padding-left: 0.2em;
                color: var(--text-secondary);
            }
            .resume-article ul > li::marker {
                color: var(--text-muted);
            }
            .resume-article strong {
                color: var(--text-main);
                font-weight: 600;
            }

            /* Wide screens and print: the date sits to the right of the heading */
            @media (min-width: 640px), print {
                .resume-article {
                    display: grid;
                    grid-template-columns: minmax(0, 1fr) auto;
                    column-gap: 1.5rem;
                }
                .resume-article > * {
                    grid-column: 1 / -1;
                }
                .resume-article > h3:has(+ p > em:only-child) {
                    grid-column: 1;
                    align-self: baseline;
                }
                .resume-article > h3 + p:has(> em:only-child) {
                    grid-column: 2;
                    align-self: baseline;
                    justify-self: end;
                    white-space: nowrap;
                }
            }

            @media print {
                /*
                 * Footer: credit and page numbers on the right; the "Name · Title" on the left is added by resume-vault.ts after unlocking,
                 * because in an encrypted resume the name must not appear in plain text on the page. Newer Chrome (131+) supports content in the page margins
                 */
                @page {
                    size: A4;
                    margin: 12mm 12mm 14mm;

                    @bottom-right {
                        content: 'Generated by Vergil Astro Theme · ' counter(page) ' / ' counter(pages);
                        color: #9a9a9a;
                        font-family: ui-sans-serif, -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
                        font-size: 7.5pt;
                    }
                }
                /* Print keeps the on-screen two-column design: the sidebar background, avatar and accent colors must all print */
                html {
                    -webkit-print-color-adjust: exact;
                    print-color-adjust: exact;
                }
                /* In dark mode the page switches back to light before printing (see resume-vault.ts); this is a fallback so it still prints dark text on a light background if that fails */
                html.dark {
                    --text-main: #1f1f1f !important;
                    --text-secondary: #3a3a3a !important;
                    --text-muted: #6b6b6b !important;
                    --bg-main: #fff !important;
                    --bg-card: #fff !important;
                    --bg-muted: #f3f1ee !important;
                    --border-main: #b5b5b5 !important;
                    --border-light: #dcdcdc !important;
                }
                body {
                    background: white !important;
                }
                .skip-link {
                    display: none !important;
                }
                /* When the paper is exactly as wide as the A4 content area, the 1px right border falls outside the printable area and gets clipped, so inset both sides slightly */
                .resume-frame {
                    max-width: none !important;
                    padding: 0 0.5mm !important;
                }
                /*
                 * A bordered sheet with rounded corners, same as on screen. Only the start and end are rounded; page breaks stay open (box-decoration-break's default slice),
                 * so you can tell the paper continues on the next page. The A4 content width is below the md breakpoint, so the on-screen two columns are written out again here
                 */
                .resume-paper {
                    display: grid !important;
                    grid-template-columns: 52mm minmax(0, 1fr);
                    border: 1px solid var(--border-light) !important;
                    border-radius: 5mm !important;
                    box-shadow: none !important;
                }
                .resume-side {
                    padding: 7mm 5mm !important;
                    border: 0 !important;
                    border-right: 1px solid var(--border-light) !important;
                }
                .resume-side > div {
                    position: static !important;
                }
                .resume-main {
                    padding: 6mm 7mm 4mm !important;
                }
                .resume-article {
                    font-size: 9.5pt;
                    line-height: 1.55;
                }
                .resume-article > h2 {
                    margin-top: 1.4em;
                    font-size: 11pt;
                }
                .resume-article > h3 {
                    margin-top: 0.9em;
                    font-size: 10pt;
                }
                .resume-article > h2,
                .resume-article > h3 {
                    break-after: avoid;
                }
                .resume-article li {
                    break-inside: avoid;
                }
                .resume-article a {
                    color: inherit;
                    text-decoration: none;
                }
            }
        </style>
    </body>
</html>
