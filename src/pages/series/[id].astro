---
import { getCollection } from 'astro:content';
import { t } from '../../i18n';
import PostPreview from '../../components/content/PostPreview.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { getAllSeries, getPostDir, getPostsBySeries, sortItemsByDateDesc } from '../../utils/data-utils';

export async function getStaticPaths() {
    const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(sortItemsByDateDesc);
    const defs = (await getCollection('series')).map((s) => ({ id: s.id, name: s.data.name, dir: s.data.dir }));
    // 专栏可能完全靠 dir 认领目录，文章里一个 series 都没写，
    // 只从文章 frontmatter 推导会漏掉这种专栏
    const fromPosts = getAllSeries(posts);
    const fromDirs = defs.filter((d) => d.dir && posts.some((p) => getPostDir(p)?.toLowerCase() === d.dir!.toLowerCase()));
    const allSeries = [...fromPosts, ...fromDirs.filter((d) => !fromPosts.some((f) => f.id === d.id))];
    if (allSeries.length === 0) {
        return [{ params: { id: '_empty' }, props: { seriesName: '' } }];
    }
    return allSeries.map((s) => ({
        params: { id: s.id },
        props: { seriesName: s.name }
    }));
}

interface Props { seriesName: string }
const { seriesName } = Astro.props;
const { id } = Astro.params;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const seriesEntries = await getCollection('series');
const seriesDefs = seriesEntries.map((s) => ({ id: s.id, name: s.data.name, dir: s.data.dir }));
const seriesPosts = getPostsBySeries(allPosts, id as string, seriesDefs);

const seriesMeta = seriesEntries.find((s) => s.id === id);
---

<BaseLayout title={t.page.series.titleOf(seriesName)} description={seriesMeta?.data.description || t.page.series.descriptionOf(seriesName)} showHeader={false}>
    <Breadcrumb crumbs={[{ text: t.common.home, href: '/' }, { text: t.nav.series, href: '/series' }, { text: seriesName }]} />

    <h1 class="ui-title mb-2 font-display text-xl sm:text-2xl">{seriesMeta?.data.name || seriesName}</h1>
    {seriesMeta?.data.description && (
        <p class="text-sm text-secondary mb-6">{seriesMeta.data.description}</p>
    )}
    <p class="text-sm text-muted mb-10">{t.page.series.postsCount(seriesPosts.length)}</p>

    {seriesPosts.map((post) => {
        const hasBanner = !!post.data.banner;
        return (
            <div class={`reveal rounded-[24px] bg-[var(--bg-card)] p-4 mb-4 sm:mb-4 shadow-[0_1px_4px_-2px_rgba(0,0,0,0.2)] card-interactive hover:-translate-y-1 ${hasBanner ? 'hover:shadow-[0_12px_24px_-4px_rgba(0,0,0,0.28),0_6px_12px_-2px_rgba(0,0,0,0.14)]' : 'hover:shadow-[0_6px_12px_-4px_rgba(0,0,0,0.10),0_4px_8px_-2px_rgba(0,0,0,0.06)]'}`}>
                <PostPreview post={post} class="" />
            </div>
        );
    })}
</BaseLayout>
