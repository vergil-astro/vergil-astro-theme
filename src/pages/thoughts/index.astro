---
import { getCollection } from 'astro:content';
import { ChevronDown } from '@lucide/astro';
import { t } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThoughtCard from '../../components/content/ThoughtCard.astro';
import DirectiveStyles from '../../components/base/DirectiveStyles.astro';

// 获取所有想法，按日期降序排列
const allThoughts = await getCollection('thoughts');
allThoughts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// 提取所有唯一标签，按使用频率排序
const tagCounts = new Map<string, number>();
allThoughts.forEach((thought) => {
    thought.data.tags.forEach((tag) => {
        tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
    });
});
const allTags = Array.from(tagCounts.entries())
    .sort((a, b) => b[1] - a[1])
    .map(([tag]) => tag);

// 所有想法都在构建时渲染好，前端只控制显示多少条
const PAGE_SIZE = 10;

// 标签展示：默认显示前8个，超出可展开
const VISIBLE_TAG_COUNT = 8;
const hasMoreTags = allTags.length > VISIBLE_TAG_COUNT;
const visibleTags = hasMoreTags ? allTags.slice(0, VISIBLE_TAG_COUNT) : allTags;
const hiddenTags = hasMoreTags ? allTags.slice(VISIBLE_TAG_COUNT) : [];

---

<BaseLayout
    title={t.page.thoughts.title}
    description={t.page.thoughts.description}
    showRightSidebar={false}
>
    <!-- 标签筛选器 -->
    {allTags.length > 0 && (
        <div class="mb-6">
            <div class="flex flex-wrap gap-2" id="thought-tags-filter">
                <button
                    type="button"
                    class="thought-filter-btn text-sm px-3 py-1 rounded-full border border-[var(--border-light)] text-[var(--text-secondary)] hover:border-[var(--accent-color)] hover:text-[var(--accent-color)] transition-colors bg-transparent cursor-pointer active"
                    data-tag=""
                >
                    {t.common.all}
                </button>
                {visibleTags.map((tag) => (
                    <button
                        type="button"
                        class="thought-filter-btn text-sm px-3 py-1 rounded-full border border-[var(--border-light)] text-[var(--text-secondary)] hover:border-[var(--accent-color)] hover:text-[var(--accent-color)] transition-colors bg-transparent cursor-pointer"
                        data-tag={tag}
                    >
                        #{tag}
                        <span class="text-[var(--text-muted)] ml-1">({tagCounts.get(tag)})</span>
                    </button>
                ))}
                {hasMoreTags && (
                    <button
                        type="button"
                        id="thought-tags-more-btn"
                        class="text-sm px-3 py-1 rounded-full border border-[var(--border-light)] text-[var(--text-muted)] hover:border-[var(--accent-color)] hover:text-[var(--accent-color)] transition-colors bg-transparent cursor-pointer"
                    >
                        {t.common.more}...
                    </button>
                )}
            </div>
            {hasMoreTags && (
                <div id="thought-tags-hidden" class="flex flex-wrap gap-2 mt-2 hidden">
                    {hiddenTags.map((tag) => (
                        <button
                            type="button"
                            class="thought-filter-btn text-sm px-3 py-1 rounded-full border border-[var(--border-light)] text-[var(--text-secondary)] hover:border-[var(--accent-color)] hover:text-[var(--accent-color)] transition-colors bg-transparent cursor-pointer"
                            data-tag={tag}
                        >
                            #{tag}
                            <span class="text-[var(--text-muted)] ml-1">({tagCounts.get(tag)})</span>
                        </button>
                    ))}
                    <button
                        type="button"
                        id="thought-tags-less-btn"
                        class="text-sm px-3 py-1 rounded-full border border-[var(--border-light)] text-[var(--text-muted)] hover:border-[var(--accent-color)] hover:text-[var(--accent-color)] transition-colors bg-transparent cursor-pointer"
                    >
                        {t.common.collapse}
                    </button>
                </div>
            )}
        </div>
    )}

    <!-- 想法卡片流 -->
    <DirectiveStyles content={allThoughts.map((thought) => thought.body || '').join('\n')} />
    <div id="thoughts-feed" class="space-y-4" data-page-size={PAGE_SIZE}>
        {allThoughts.map((thought, index) => (
            <div class="reveal thought-item" data-tags={JSON.stringify(thought.data.tags)} hidden={index >= PAGE_SIZE}>
                <ThoughtCard thought={thought} />
            </div>
        ))}
    </div>

    <!-- 加载更多 -->
    <div id="thoughts-load-more" class="py-6 text-center">
        <button
            id="thoughts-load-btn"
            class="text-sm text-[var(--text-secondary)] hover:text-[var(--accent-color)] transition-colors flex items-center gap-1.5 mx-auto bg-transparent border-0 cursor-pointer"
        >
            <ChevronDown class="w-4 h-4" />
            <span>{t.common.loadMore}</span>
        </button>
        <div id="thoughts-loading" class="hidden text-sm text-[var(--text-muted)] flex items-center justify-center gap-2">
            <svg class="animate-spin" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
            <span>{t.common.loadingDots}</span>
        </div>
        <div id="thoughts-no-more" class="hidden text-sm text-[var(--text-muted)]">{t.page.thoughts.noMore}</div>

        <!-- 骨架屏 -->
        <div id="thoughts-skeleton" class="hidden space-y-4 mt-4">
            <div class="rounded-xl bg-[var(--bg-card)] p-5">
                <div class="skeleton h-3 w-20 rounded mb-3"></div>
                <div class="skeleton h-3 w-full rounded mb-2"></div>
                <div class="skeleton h-3 w-3/4 rounded"></div>
            </div>
            <div class="rounded-xl bg-[var(--bg-card)] p-5">
                <div class="skeleton h-3 w-16 rounded mb-3"></div>
                <div class="skeleton h-3 w-full rounded mb-2"></div>
                <div class="skeleton h-3 w-1/2 rounded"></div>
            </div>
        </div>
    </div>

    <!-- 空状态 -->
    {allThoughts.length === 0 && (
        <div class="text-center py-12 text-[var(--text-muted)]">
            <p>{t.page.thoughts.empty}</p>
        </div>
    )}
</BaseLayout>

<script is:inline>
(function() {
    if (window.__thoughtsPageScriptLoaded) return;
    window.__thoughtsPageScriptLoaded = true;

    var feed = document.getElementById('thoughts-feed');
    var loadBtn = document.getElementById('thoughts-load-btn');
    var loading = document.getElementById('thoughts-loading');
    var noMore = document.getElementById('thoughts-no-more');
    var skeleton = document.getElementById('thoughts-skeleton');
    var tagFilterContainer = document.getElementById('thought-tags-filter');

    if (!feed) return;

    // 所有想法都已在构建时渲染，这里只负责显示多少条、显示哪些
    var items = Array.prototype.slice.call(feed.querySelectorAll('.thought-item'));
    var pageSize = parseInt(feed.dataset.pageSize || '10', 10);
    var shownCount = Math.min(pageSize, items.length);
    var currentFilterTag = '';
    var loadingLock = false;

    function getFilteredItems() {
        if (!currentFilterTag) return items;
        return items.filter(function(item) {
            var tags = JSON.parse(item.dataset.tags || '[]');
            return tags.indexOf(currentFilterTag) !== -1;
        });
    }

    // 显示筛选结果里的前 shownCount 条，其余隐藏
    function render() {
        var filtered = getFilteredItems();
        items.forEach(function(item) {
            item.hidden = true;
        });
        filtered.slice(0, shownCount).forEach(function(item) {
            item.hidden = false;
            item.classList.add('visible');
        });
        var hasMore = shownCount < filtered.length;
        if (loadBtn) loadBtn.classList.toggle('hidden', !hasMore);
        if (noMore) noMore.classList.toggle('hidden', hasMore);
    }

    // 加载更多：保留加载动画和骨架屏的过渡
    function loadMore() {
        if (loadingLock || shownCount >= getFilteredItems().length) return;
        loadingLock = true;
        if (loadBtn) loadBtn.classList.add('hidden');
        if (loading) loading.classList.remove('hidden');
        if (skeleton) skeleton.classList.remove('hidden');

        setTimeout(function() {
            shownCount += pageSize;
            if (loading) loading.classList.add('hidden');
            if (skeleton) skeleton.classList.add('hidden');
            render();
            loadingLock = false;
        }, 300);
    }

    if (loadBtn) {
        loadBtn.addEventListener('click', loadMore);
    }

    // 无限滚动
    var scrollHandler = function() {
        if (shownCount >= getFilteredItems().length) return;
        var scrollTop = window.scrollY || document.documentElement.scrollTop;
        var docHeight = document.documentElement.scrollHeight;
        var winHeight = window.innerHeight;
        if (scrollTop + winHeight >= docHeight - 200) {
            loadMore();
        }
    };
    window.addEventListener('scroll', scrollHandler, { passive: true });

    // 标签筛选
    function setupTagFilter(container) {
        if (!container) return;
        container.addEventListener('click', function(e) {
            var btn = e.target.closest('.thought-filter-btn');
            if (!btn) return;

            document.querySelectorAll('.thought-filter-btn').forEach(function(b) {
                b.classList.remove('active');
                b.style.borderColor = '';
                b.style.color = '';
            });
            btn.classList.add('active');
            btn.style.borderColor = 'var(--accent-color)';
            btn.style.color = 'var(--accent-color)';

            currentFilterTag = btn.dataset.tag || '';
            shownCount = pageSize;
            render();
        });
    }

    // 「更多」展开区里的标签在另一个容器里，也要绑上，否则使用次数少的标签点了没反应
    setupTagFilter(tagFilterContainer);
    setupTagFilter(document.getElementById('thought-tags-hidden'));
    render();

    // 标签更多/收起
    var tagsMoreBtn = document.getElementById('thought-tags-more-btn');
    var tagsHidden = document.getElementById('thought-tags-hidden');
    var tagsLessBtn = document.getElementById('thought-tags-less-btn');

    if (tagsMoreBtn && tagsHidden) {
        tagsMoreBtn.addEventListener('click', function() {
            tagsHidden.classList.remove('hidden');
            tagsMoreBtn.classList.add('hidden');
        });
    }
    if (tagsLessBtn && tagsHidden && tagsMoreBtn) {
        tagsLessBtn.addEventListener('click', function() {
            tagsHidden.classList.add('hidden');
            tagsMoreBtn.classList.remove('hidden');
        });
    }

    // 监听卡片内标签点击事件
    document.addEventListener('thought:filterByTag', function(e) {
        var tag = e.detail && e.detail.tag;
        if (!tag || !tagFilterContainer) return;

        var btn = document.querySelector('.thought-filter-btn[data-tag="' + CSS.escape(tag) + '"]');
        if (btn) {
            btn.click();
        }
    });
})();
</script>

<style is:global>
    .thought-filter-btn.active {
        border-color: var(--accent-color) !important;
        color: var(--accent-color) !important;
    }
</style>
