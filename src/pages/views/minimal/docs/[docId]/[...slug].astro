---
import { t } from '../../../../../i18n';
import DirectiveStyles from '../../../../../components/base/DirectiveStyles.astro';
import { getCollection, render } from 'astro:content';
import MinimalLayout from '../../../../../views/minimal/layouts/MinimalLayout.astro';
import Breadcrumb from '../../../../../components/ui/Breadcrumb.astro';
import { getDocSets, getDocEntry, getDocTree } from '../../../../../utils/docs-utils';
import siteConfig from '@vergil-site/data/site-config';

export async function getStaticPaths() {
    if (siteConfig.views?.minimal?.enabled !== true) return [];
    const entries = await getCollection('docs', ({ data }) => !data.draft);
    const nonMeta = entries.filter((e) => !(e.id.endsWith('/_meta') || e.id === '_meta'));
    return nonMeta
        .map((entry) => {
            const parts = entry.id.split('/');
            const docId = parts[0];
            const slug = parts.slice(1).join('/').replace(/\/index$/, '');
            return { params: { docId, slug } };
        })
        .filter((p) => p.params.slug !== '');
}

const { docId, slug } = Astro.params;
const entry = await getDocEntry(docId, slug);
if (!entry) {
    return new Response('Not Found', { status: 404 });
}

const { Content } = await render(entry);
const sets = await getDocSets();
const currentSet = sets.find((s) => s.id === docId);
const metaTitle = (currentSet?.meta.data.title as string) ?? docId;

// Build breadcrumbs: extract the levels from the slug path
const slugParts = slug.split('/');
const tree = await getDocTree(docId);

const crumbs: { text: string; href?: string }[] = [
    { text: t.page.minimal.docs, href: '/views/minimal/?type=docs' },
    { text: metaTitle, href: `/views/minimal/?type=docs&cat=${docId}` }
];

// Look up the group name for each level of the slug path
let currentNodes = tree;
for (let i = 0; i < slugParts.length - 1; i++) {
    const dirPath = i === 0 ? slugParts[0] : slugParts.slice(0, i + 1).join('/');
    const group = currentNodes.find((n: any) => n.type === 'group' && n.dirPath === dirPath);
    if (group) {
        // Intermediate levels all link back to this knowledge base's list page
        crumbs.push({ text: group.title, href: `/views/minimal/?type=docs&cat=${docId}` });
        currentNodes = group.children;
    }
}

crumbs.push({ text: entry.data.title as string });
---

<MinimalLayout
    title={entry.data.title as string}
    description={(entry.data.excerpt as string) ?? ''}
    pageType="article"
    showBackLink={metaTitle}
    backHref={`/views/minimal/?type=docs&cat=${docId}`}
    showBreadcrumb={true}
>
    <Breadcrumb crumbs={crumbs} slot="breadcrumb" />

    <article class="mb-12">
        <header class="mb-8">
            <h1 class="font-display text-2xl leading-tight font-medium sm:text-3xl sm:leading-tight">{entry.data.title}</h1>
            {entry.data.excerpt && (
                <p class="mt-3 text-sm text-secondary">{entry.data.excerpt}</p>
            )}
        </header>
        <div class="prose sm:prose-lg max-w-none">
            <DirectiveStyles content={entry.body || ''} />
            <Content />
        </div>
    </article>
</MinimalLayout>
