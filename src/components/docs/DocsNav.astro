---
import type { DocArticleNode } from '../../utils/docs-utils';
import { getDocHomepageSlug } from '../../utils/docs-utils';
import PrevNext from '../base/PrevNext.astro';

interface Props {
    docId: string;
    prev: DocArticleNode | null;
    next: DocArticleNode | null;
}

const { docId, prev, next } = Astro.props;

/**
 * A knowledge base's first doc is rendered at the knowledge base root path; its own path gets no page.
 * So this must follow the same rules as the left directory tree, or prev/next would point to a 404.
 */
const homepageSlug = await getDocHomepageSlug(docId);

const toItem = (node: DocArticleNode | null) => {
    if (!node) return null;
    const normalized = node.slug.replace(/\/index$/, '');
    const isHomepage = homepageSlug && normalized.toLowerCase() === homepageSlug.toLowerCase();
    return { href: isHomepage ? `/docs/${docId}/` : `/docs/${docId}/${node.slug}/`, title: node.title };
};
---

<PrevNext prev={toItem(prev)} next={toItem(next)} />
