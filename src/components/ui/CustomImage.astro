---
import { Image } from 'astro:assets';
import type { ImageInput } from '../../types';

type Props = ImageInput & {
    class?: string;
    width?: number;
    height?: number;
    sizes?: string;
    widths?: number[];
    format?: 'avif' | 'webp' | 'png' | 'jpg' | 'jpeg';
    loading?: 'lazy' | 'eager';
    fetchpriority?: 'high' | 'low' | 'auto';
    decoding?: 'async' | 'sync' | 'auto';
    inferSize?: boolean;
};

const { src, alt = '', class: className, loading = 'lazy', fetchpriority, decoding = 'async', inferSize, ...rest } = Astro.props as Props;

// Whether this is a remote image (one with configured domains)
const isRemote = typeof src === 'string' && /^https?:\/\//.test(src);
// Whether this is a local public path
const isLocalPath = typeof src === 'string' && src.startsWith('/') && !src.startsWith('//');
// Astro Image supports locally imported ImageMetadata and remote images from configured domains
const isImageMetadata = typeof src === 'object' && src !== null && 'src' in src && 'width' in src && 'height' in src;
const canUseAstroImage = isImageMetadata || isRemote;
---

{
    canUseAstroImage ? (
        <Image
            class={className}
            src={src}
            alt={alt}
            loading={loading}
            fetchpriority={fetchpriority}
            decoding={decoding}
            inferSize={isRemote ? (inferSize ?? true) : inferSize}
            {...(rest as Record<string, unknown>)}
        />
    ) : (
        <img class={className} src={src} alt={alt} loading={loading} decoding={decoding} />
    )
}
