---
import { t, locale } from '../../i18n';

const searchDataUrl = '/search-data.json';
---

<div class="search-container relative">
    <button
        id="search-trigger"
        class="hidden"
        aria-label="Open search"
    >
        <span>Search</span>
    </button>

    <dialog
        id="search-dialog"
        class="ui-modal max-h-[80vh] w-[92vw] max-w-2xl rounded-xl bg-main p-0 shadow-2xl backdrop:bg-black/50 border border-light/30"
    >
        <div class="flex flex-col">
            <!-- Search Input -->
            <div class="border-b border-light/40 p-4">
                <div class="relative">
                    <svg
                        class="absolute left-3.5 top-1/2 h-5 w-5 -translate-y-1/2 text-muted"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.3-4.3"/>
                    </svg>
                    <input
                        type="text"
                        id="search-input"
                        placeholder={t.search.placeholder}
                        class="ui-input w-full rounded-lg bg-card py-3 pl-11 pr-4 text-main outline-none placeholder:text-muted/60 transition-colors focus:bg-card/80"
                        autocomplete="off"
                    />
                </div>
            </div>

            <!-- Results -->
            <div id="search-results" class="max-h-[62vh] overflow-y-auto px-2 py-2">
                <p class="text-center text-secondary text-sm py-8">{t.search.hint}</p>
            </div>

            <!-- Footer -->
            <div class="border-t border-light/40 px-4 py-2.5 flex items-center justify-between text-[11px] text-muted">
                <span id="search-status"></span>
                <div class="flex items-center gap-3">
                    <span class="flex items-center gap-1"><kbd class="rounded bg-card px-1 py-0.5 border border-light/30">↑↓</kbd> {t.search.kbdSelect}</span>
                    <span class="flex items-center gap-1"><kbd class="rounded bg-card px-1 py-0.5 border border-light/30">↵</kbd> {t.search.kbdOpen}</span>
                    <span class="flex items-center gap-1"><kbd class="rounded bg-card px-1 py-0.5 border border-light/30">esc</kbd> {t.search.kbdClose}</span>
                </div>
            </div>
        </div>
    </dialog>
</div>

<script>
    // Bundled by Vite so fuse.js is served from this site; the chunk is still
    // fetched lazily, only when the search dialog is first used.
    window.__loadFuse = () => import('fuse.js').then((m) => m.default);
</script>

<script is:inline data-search-url={searchDataUrl} define:vars={{ i18n: { loading: t.search.loading, hint: t.search.hint, empty: t.search.empty, resultsZero: t.search.results(0), resultsOne: t.search.results(1), resultsMany: t.search.results(9999), types: t.search.types, failed: t.search.failed, locale } }}>
(function() {
    const script = document.currentScript;
    const searchUrl = script.dataset.searchUrl;

    // Global state — persists across ViewTransitions page swaps
    const S = window._searchState = window._searchState || {
        fuse: null,
        searchData: [],
        isLoading: false,
        error: null,
        searchUrl: searchUrl,
        listenersBound: false
    };
    if (searchUrl) S.searchUrl = searchUrl;

    let selectedIndex = -1;

    const VIOLET = 'text-violet-600 bg-violet-50 border-violet-200 dark:text-violet-400 dark:bg-violet-900/20 dark:border-violet-800';
    const EMERALD = 'text-emerald-600 bg-emerald-50 border-emerald-200 dark:text-emerald-400 dark:bg-emerald-900/20 dark:border-emerald-800';
    const SLATE = 'text-slate-600 bg-slate-100 border-slate-200 dark:text-slate-300 dark:bg-slate-800/40 dark:border-slate-700';
    const typeConfig = {
        post:    { label: i18n.types.post,    color: 'text-accent bg-accent/10 border-accent/20' },
        project: { label: i18n.types.project, color: EMERALD },
        doc:     { label: i18n.types.doc,     color: VIOLET },
        thought: { label: i18n.types.thought, color: SLATE },
        moment:  { label: i18n.types.moment,  color: SLATE },
        album:   { label: i18n.types.album,   color: SLATE },
        series:  { label: i18n.types.series,  color: SLATE },
        page:    { label: i18n.types.page,    color: SLATE }
    };

    function getEls() {
        return {
            dialog: document.getElementById('search-dialog'),
            input: document.getElementById('search-input'),
            results: document.getElementById('search-results'),
            status: document.getElementById('search-status')
        };
    }

    function setStatus(text) {
        const els = getEls();
        if (els.status) els.status.textContent = text;
    }

    function showMessage(text) {
        const els = getEls();
        if (els.results) els.results.innerHTML = '<p class="text-center text-secondary text-sm py-8">' + escapeHtml(text) + '</p>';
        setStatus('');
    }

    function setLoading(loading) {
        S.isLoading = loading;
        if (loading) { showMessage(i18n.loading); return; }
        // After a load failure, don't overwrite the error message, otherwise the UI looks perfectly normal
        // but typing does nothing, with no sign that the index failed to load.
        showMessage(S.error ? i18n.failed : i18n.hint);
    }

    async function initSearch() {
        if (S.fuse) return;
        try {
            S.error = null;
            const response = await fetch(S.searchUrl);
            // Without checking the status code, the HTML from a 404 blows up in json(),
            // and the reported error has nothing to do with the real cause.
            if (!response.ok) throw new Error('search-data.json HTTP ' + response.status);
            S.searchData = await response.json();
            if (!Array.isArray(S.searchData) || S.searchData.length === 0) {
                throw new Error('search index is empty');
            }
            const Fuse = await window.__loadFuse();
            S.fuse = new Fuse(S.searchData, {
                keys: ['title', 'description', 'content', 'tags'],
                threshold: 0.35,
                // By default Fuse only matches within distance (100) characters of the field start. Post bodies often run to thousands of characters,
                // so without turning off location weighting, words in the middle or later parts of a post are never found.
                ignoreLocation: true,
                includeScore: true,
                includeMatches: true
            });
        } catch (error) {
            S.error = error;
            console.error('[search] Failed to load the search index:', error);
            showMessage(i18n.failed);
        }
    }

    function escapeHtml(str) {
        return str
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function highlightMatches(text, matches, key) {
        if (!matches || !matches.length) return escapeHtml(text);

        const keyMatches = matches.filter(m => m.key === key);
        if (!keyMatches.length) return escapeHtml(text);

        let indices = [];
        keyMatches.forEach(m => {
            indices.push(...m.indices);
        });

        indices.sort((a, b) => a[0] - b[0]);

        let merged = [];
        for (let i = 0; i < indices.length; i++) {
            if (merged.length === 0) {
                merged.push([...indices[i]]);
            } else {
                const last = merged[merged.length - 1];
                if (indices[i][0] <= last[1] + 1) {
                    last[1] = Math.max(last[1], indices[i][1]);
                } else {
                    merged.push([...indices[i]]);
                }
            }
        }

        let parts = [];
        let lastEnd = text.length;
        for (let i = merged.length - 1; i >= 0; i--) {
            const [start, end] = merged[i];
            parts.unshift(escapeHtml(text.slice(end + 1, lastEnd)));
            parts.unshift('</mark>');
            parts.unshift(escapeHtml(text.slice(start, end + 1)));
            parts.unshift('<mark>');
            lastEnd = start;
        }
        parts.unshift(escapeHtml(text.slice(0, lastEnd)));
        return parts.join('');
    }

    function getItemUrl(item) {
        if (item.url) return item.url;
        if (item.type === 'post') return '/blog/' + item.id + '/';
        if (item.type === 'project') return '/projects/' + item.id + '/';
        return '/' + item.id + '/';
    }

    function formatDate(dateStr) {
        if (!dateStr) return '';
        try {
            // Format in the site's UI language, not the visitor's browser language, like the rest of the page
            return new Date(dateStr).toLocaleDateString(i18n.locale);
        } catch (e) {
            return '';
        }
    }

    function highlightAllInElement(el, query) {
        if (!el || !query) return;
        const lowerQuery = query.toLowerCase();
        const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null, false);
        const nodes = [];
        let n;
        while ((n = walker.nextNode())) {
            if (n.parentElement && n.parentElement.closest('mark')) continue;
            nodes.push(n);
        }
        nodes.forEach(function (node) {
            const text = node.textContent || '';
            const lowerText = text.toLowerCase();
            let idx = lowerText.indexOf(lowerQuery);
            if (idx === -1) return;
            const parent = node.parentNode;
            const frag = document.createDocumentFragment();
            let last = 0;
            while (idx !== -1) {
                if (idx > last) {
                    frag.appendChild(document.createTextNode(text.slice(last, idx)));
                }
                const mark = document.createElement('mark');
                mark.textContent = text.slice(idx, idx + query.length);
                frag.appendChild(mark);
                last = idx + query.length;
                idx = lowerText.indexOf(lowerQuery, last);
            }
            if (last < text.length) {
                frag.appendChild(document.createTextNode(text.slice(last)));
            }
            parent.replaceChild(frag, node);
        });
    }

    function renderResults(results) {
        const els = getEls();
        if (!els.results) return;

        if (!results.length) {
            els.results.innerHTML = '<p class="text-center text-secondary text-sm py-8">' + escapeHtml(i18n.empty) + '</p>';
            selectedIndex = -1;
            setStatus(i18n.resultsZero);
            return;
        }
        selectedIndex = -1;
        const html = results.map((result, idx) => {
            const item = result.item;
            const matches = result.matches;
            const url = getItemUrl(item);
            const tConfig = typeConfig[item.type] || typeConfig.post;
            const titleHtml = highlightMatches(item.title, matches, 'title');
            const desc = item.description || item.content.slice(0, 160) + '...';
            const descHtml = highlightMatches(desc, matches, 'description') || highlightMatches(desc, matches, 'content');
            const dateStr = formatDate(item.date);
            return `
                <a href="${url}" class="search-result-item group block rounded-lg px-3 py-3 hover:bg-hover transition-colors" data-index="${idx}">
                    <div class="flex items-center gap-2 text-[11px] mb-1.5">
                        <span class="inline-flex items-center gap-1 rounded-md px-1.5 py-0.5 font-medium border ${tConfig.color}">${tConfig.label}</span>
                        ${dateStr ? '<span class="text-muted">' + escapeHtml(dateStr) + '</span>' : ''}
                    </div>
                    <h3 class="font-display text-[15px] text-main mb-1 leading-snug search-result-title">${titleHtml}</h3>
                    <p class="text-[13px] text-secondary leading-relaxed line-clamp-2 search-result-desc">${descHtml}</p>
                </a>
            `;
        }).join('');
        els.results.innerHTML = html;
        // The dictionary's results(n) is a function and can't be passed to this inline script, so the
        // page carries it rendered for 1 and for the placeholder 9999; the real count replaces the placeholder
        setStatus(results.length === 1 ? i18n.resultsOne : i18n.resultsMany.replace('9999', String(results.length)));

        const query = document.getElementById('search-input')?.value.trim();
        if (query) {
            const items = els.results.querySelectorAll('.search-result-item');
            items.forEach(function (item) {
                highlightAllInElement(item.querySelector('.search-result-title'), query);
                highlightAllInElement(item.querySelector('.search-result-desc'), query);
            });
        }
    }

    function updateSelected() {
        const els = getEls();
        if (!els.results) return;
        const items = els.results.querySelectorAll('.search-result-item');
        items.forEach((item, idx) => {
            if (idx === selectedIndex) {
                item.classList.add('bg-accent/8');
                item.classList.add('border-l-2');
                item.classList.add('border-l-accent');
                item.classList.add('pl-[10px]');
                item.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            } else {
                item.classList.remove('bg-accent/8');
                item.classList.remove('border-l-2');
                item.classList.remove('border-l-accent');
                item.classList.remove('pl-[10px]');
            }
        });
    }

    // Bind global events only once
    if (!S.listenersBound) {
        // open-search event
        document.addEventListener('open-search', async () => {
            if (!S.fuse && !S.isLoading) {
                setLoading(true);
                await initSearch();
                setLoading(false);
            }
            const els = getEls();
            els.dialog?.showModal();
            setTimeout(() => els.input?.focus(), 50);
        });

        // Keyboard shortcuts — always use the latest DOM references
        document.addEventListener('keydown', (e) => {
            if (e.key === 'k' && (e.metaKey || e.ctrlKey)) {
                e.preventDefault();
                document.dispatchEvent(new CustomEvent('open-search'));
                return;
            }

            const els = getEls();
            if (!els.dialog?.open) return;

            if (e.key === 'Escape') {
                els.dialog.close();
                return;
            }

            if (!els.results) return;
            const items = els.results.querySelectorAll('.search-result-item');
            if (!items.length) return;

            if (e.key === 'ArrowDown') {
                e.preventDefault();
                selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
                updateSelected();
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                selectedIndex = Math.max(selectedIndex - 1, -1);
                updateSelected();
                if (selectedIndex === -1) {
                    els.input?.focus();
                }
            } else if (e.key === 'Enter') {
                if (selectedIndex >= 0 && items[selectedIndex]) {
                    e.preventDefault();
                    items[selectedIndex].click();
                }
            }
        });

        // Event delegation: handles clicks inside search-results and on the dialog backdrop
        document.addEventListener('click', (e) => {
            const els = getEls();

            // Clicking the dialog backdrop closes it
            if (els.dialog && e.target === els.dialog) {
                els.dialog.close();
                return;
            }

            // Clicking a search result closes the dialog
            if (els.results && els.results.contains(e.target)) {
                const link = e.target.closest('.search-result-item');
                if (link && els.dialog) {
                    els.dialog.close();
                }
            }
        });

        // Event delegation: input events
        document.addEventListener('input', (e) => {
            if (e.target.id !== 'search-input') return;
            const els = getEls();
            const query = e.target.value.trim();
            if (!query) {
                if (els.results) els.results.innerHTML = '<p class="text-center text-secondary text-sm py-8">' + escapeHtml(i18n.hint) + '</p>';
                selectedIndex = -1;
                setStatus('');
                return;
            }
            if (!S.fuse) {
                // A silent return would look like "no results", when in fact the index never loaded
                if (S.error) { showMessage(i18n.failed); return; }
                if (S.isLoading) { showMessage(i18n.loading); return; }
                setLoading(true);
                initSearch().then(() => {
                    setLoading(false);
                    // Re-run once for the query the user typed while loading; don't retry on failure, to avoid an endless loop
                    if (S.error) return;
                    const el = document.getElementById('search-input');
                    if (el && el.value.trim()) el.dispatchEvent(new Event('input', { bubbles: true }));
                });
                return;
            }
            const results = S.fuse.search(query).slice(0, 10);
            renderResults(results);
        });

        S.listenersBound = true;
    }
})();
</script>

<style is:global>
    /* It used to be vertically centered with m-auto: whenever the result count changed, the dialog height changed,
       and centering moved it back to the middle, so the whole box jumped up and down with every keystroke.
       Now it is pinned at a fixed distance from the top and only grows downward; the top edge stays put. */
    #search-dialog {
        margin: 10vh auto auto;
    }
    @media (max-height: 640px) {
        #search-dialog { margin-top: 4vh; }
    }

    #search-results mark {
        background-color: var(--accent-color);
        color: #fff;
        border-radius: 2px;
        padding: 0 2px;
        font-weight: 500;
    }
    .bg-accent\/8 {
        background-color: var(--accent-color);
        opacity: 0.08;
    }
    @supports (background-color: color-mix(in srgb, var(--accent-color) 8%, transparent)) {
        .bg-accent\/8 {
            background-color: color-mix(in srgb, var(--accent-color) 8%, transparent);
            opacity: 1;
        }
    }
</style>
