---
import { getImage } from 'astro:assets';
import { getSiteFonts, resolveFontOverrides } from '../../utils/fonts';
import siteConfig from '../../data/site-config';
import type { ImageInput } from '../../types';

import '../../styles/global.css';

const { fonts: fontsProp } = Astro.props as Props;
const { display: displayCss, body: bodyCss, ui: uiCss, mono: monoCss, cdnFonts, fileFonts } =
    fontsProp && (fontsProp.display || fontsProp.body)
        ? resolveFontOverrides(fontsProp)
        : getSiteFonts();

export type Props = {
    title?: string;
    description?: string;
    image?: ImageInput | undefined;
    pageType?: 'website' | 'article';
    fonts?: Partial<Record<'display' | 'body', string>>;
    preloadImages?: string[];
};

const { description = '', pageType = 'website', preloadImages = [] } = Astro.props;
const title = [Astro.props.title, siteConfig.title].filter(Boolean).join(' | ');
const image = Astro.props.image ?? siteConfig.image;
let resolvedImage: { src: string; alt?: string } | undefined;
if (image?.src) {
    if (typeof image.src === 'string') {
        resolvedImage = {
            src: new URL(image.src, Astro.site).toString(),
            alt: image.alt
        };
    } else {
        const optimizedImage = await getImage({
            src: image.src as ImageMetadata,
            width: 1200,
            height: 630,
            format: 'jpeg',
            fit: 'cover'
        });
        resolvedImage = {
            src: new URL(optimizedImage.src, Astro.site).toString(),
            alt: image.alt
        };
    }
}
const canonicalURL = new URL(Astro.request.url, Astro.site);

function formatCanonicalURL(url: string | URL) {
    const path = url.toString();
    const hasQueryParams = path.includes('?');
    if (hasQueryParams) {
        path.replace(/\/?$/, '');
    }
    return path.replace(/\/?$/, hasQueryParams ? '' : '/');
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="generator" content={Astro.generator} />

{cdnFonts.map(f => (
    <link rel="stylesheet" href={f.cdn} />
))}

{fileFonts.map(f => {
    const subsetPath = f.path.replace('.woff2', '-subset.woff2');
    const format = f.format ?? 'woff2';
    return (
        <>
            {/* Subset 版本：preload，首屏立即渲染 */}
            <link rel="preload" href={subsetPath} as="font" type={`font/${format}`} crossorigin />
            {/* Full 版本：后台加载，补充缺失字形 */}
            <style set:html={`@font-face { font-family: "${f.cssName}"; src: url("${subsetPath}") format("${format}"), url("${f.path}") format("${format}"); font-display: swap; }`} />
        </>
    );
})}

<style set:html={`
    :root {
        --font-display: ${displayCss};
        --font-body:    ${bodyCss};
        --font-ui:      ${uiCss};
        --font-mono:    ${monoCss};
    }
`} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#faf8f5" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1a1a1a" media="(prefers-color-scheme: dark)" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" href="/rss.xml" title="RSS" />

{preloadImages.map((url) => (
    <link rel="preload" as="image" href={url} fetchpriority="high" />
))}

<link rel="canonical" href={formatCanonicalURL(canonicalURL)} />
<meta name="description" content={description} />

<meta property="og:type" content={pageType} />
<meta property="og:url" content={formatCanonicalURL(canonicalURL)} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
{resolvedImage?.src && <meta property="og:image" content={resolvedImage.src} />}
{resolvedImage?.alt && <meta property="og:image:alt" content={resolvedImage.alt} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={formatCanonicalURL(canonicalURL)} />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{resolvedImage?.src && <meta name="twitter:image" content={resolvedImage.src} />}
{resolvedImage?.alt && <meta name="twitter:image:alt" content={resolvedImage.alt} />}

<!--
    内容指令里图片的加载状态。<img> 上写 onload="vergilImgLoad(this)"，调用里不带引号：
    交给 Astro 优化的本地图片，属性值里的引号会被转义两次，内联脚本一带引号就会失效。
-->
<!--
    滚动条只在滚动时显示，样式见 utilities/extras.css。
    1. 内部区域（侧栏、代码块等）：给正在滚动的元素加 is-scrolling，停下 0.8 秒后去掉。
       scroll 事件不冒泡，所以在捕获阶段统一监听。
    2. 页面本身：原生滚动条会占掉页面宽度，全宽的开屏图旁边会露出一道底色，所以整个隐藏，
       换成一根浮在最右侧的滑块，只在正文里滚动时淡入，可以拖动。
       开屏图不算进滚动范围：还停在开屏图上时不显示，滑块位置也只按正文部分计算。
-->
<script is:inline>
    (function () {
        if (window.__vergilScrollbar) return;
        window.__vergilScrollbar = true;
        var HIDE_DELAY = 800;
        var timers = new WeakMap();
        var thumb = null;
        var thumbTimer = 0;
        var hovering = false;
        var dragging = false;

        /** 开屏图的高度，没有开屏图时为 0 */
        function splashHeight() {
            var splash = document.getElementById('hero-splash');
            return splash ? splash.offsetHeight : 0;
        }

        /** 正文部分的滚动范围：[起点, 可滚动距离, 可视高度] */
        function range() {
            var start = splashHeight();
            var view = window.innerHeight;
            var total = document.documentElement.scrollHeight - start;
            return [start, Math.max(0, total - view), view];
        }

        function ensureThumb() {
            if (thumb && document.body.contains(thumb)) return thumb;
            thumb = document.createElement('div');
            thumb.id = 'vergil-scroll-thumb';
            thumb.setAttribute('aria-hidden', 'true');
            thumb.addEventListener('pointerenter', function () { hovering = true; show(); });
            thumb.addEventListener('pointerleave', function () { hovering = false; scheduleHide(); });
            thumb.addEventListener('pointerdown', startDrag);
            document.body.appendChild(thumb);
            return thumb;
        }

        function layout() {
            var r = range();
            var el = ensureThumb();
            var start = r[0], max = r[1], view = r[2];
            if (max <= 0) { el.classList.remove('is-visible'); return false; }
            var h = Math.max(32, view * view / (max + view));
            var progress = Math.min(1, Math.max(0, (window.scrollY - start) / max));
            el.style.height = h + 'px';
            el.style.transform = 'translateY(' + progress * (view - h) + 'px)';
            return true;
        }

        function show() {
            // 还停在开屏图上时不显示
            if (window.scrollY < splashHeight() - 1) { hide(); return; }
            if (!layout()) return;
            thumb.classList.add('is-visible');
            scheduleHide();
        }

        function hide() {
            if (thumb) thumb.classList.remove('is-visible');
        }

        function scheduleHide() {
            clearTimeout(thumbTimer);
            thumbTimer = setTimeout(function () {
                if (!hovering && !dragging) hide();
            }, HIDE_DELAY);
        }

        function startDrag(e) {
            e.preventDefault();
            dragging = true;
            thumb.setPointerCapture(e.pointerId);
            thumb.classList.add('is-dragging');
            var startY = e.clientY;
            var startScroll = window.scrollY;
            var r = range();
            var h = thumb.offsetHeight;
            var ratio = r[1] / Math.max(1, r[2] - h);
            function move(ev) {
                // 页面开着全局平滑滚动，这里要立即滚动，否则每一步都会重新开始一段平滑动画，拖起来发涩
                window.scrollTo({ top: startScroll + (ev.clientY - startY) * ratio, behavior: 'instant' });
            }
            function end() {
                dragging = false;
                thumb.classList.remove('is-dragging');
                thumb.removeEventListener('pointermove', move);
                thumb.removeEventListener('pointerup', end);
                thumb.removeEventListener('pointercancel', end);
                scheduleHide();
            }
            thumb.addEventListener('pointermove', move);
            thumb.addEventListener('pointerup', end);
            thumb.addEventListener('pointercancel', end);
        }

        // 页面滚动很密集，滑块的显示和位置合并到下一帧再算
        var frame = 0;
        document.addEventListener('scroll', function (e) {
            if (e.target === document) {
                if (!frame) frame = requestAnimationFrame(function () { frame = 0; show(); });
                return;
            }
            var el = e.target;
            if (!el || !el.classList) return;
            el.classList.add('is-scrolling');
            clearTimeout(timers.get(el));
            timers.set(el, setTimeout(function () { el.classList.remove('is-scrolling'); }, HIDE_DELAY));
        }, { capture: true, passive: true });

        window.addEventListener('resize', function () { if (thumb && thumb.classList.contains('is-visible')) layout(); });
        // 页面切换后 body 会被替换，滑块跟着重建
        document.addEventListener('astro:after-swap', function () { thumb = null; });
    })();
</script>

<script is:inline>
    window.vergilImgLoad = function (img) {
        img.classList.add('md-image-loaded');
        var wrap = img.closest('.md-image-img-wrap');
        if (wrap) wrap.classList.add('is-loaded');
    };
    window.vergilImgError = function (img) {
        img.classList.add('md-image-error');
        var wrap = img.closest('.md-image-img-wrap');
        if (wrap) wrap.classList.add('has-error');
    };
    // 加载失败时隐藏图片；带 data-fallback-class 时给父元素加上这个 class，显示兜底样式。
    // 带 data-fallback-src 时先换成这个备用地址再试一次，备用地址也失败才隐藏
    window.vergilImgHide = function (img) {
        var backup = img.getAttribute('data-fallback-src');
        if (backup) {
            img.removeAttribute('data-fallback-src');
            img.src = backup;
            return;
        }
        img.style.display = 'none';
        var fallback = img.getAttribute('data-fallback-class');
        if (fallback && img.parentElement) img.parentElement.classList.add(fallback);
    };
</script>

<!--
    懒加载图片的淡入：animations.css 里 img[loading="lazy"] 默认透明，加载完加上 img-loaded 才显示。
    这段脚本放在所有布局共用的 BaseHead 里；之前只在 BaseLayout 里，文档、极简、简历页面的懒加载图片一直是透明的。
-->
<script is:inline>
    (function () {
        function initLazyImages() {
            document.querySelectorAll('img[loading="lazy"]').forEach(function (img) {
                if (img.complete) {
                    img.classList.add('img-loaded');
                } else {
                    img.addEventListener('load', function () {
                        img.classList.add('img-loaded');
                    });
                    img.addEventListener('error', function () {
                        img.classList.add('img-loaded');
                    });
                }
            });
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initLazyImages);
        } else {
            initLazyImages();
        }
        document.addEventListener('astro:page-load', initLazyImages);
    })();
</script>
