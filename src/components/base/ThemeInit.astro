---
/**
 * Before the page paints, writes the visitor's chosen skin, scheme and dark mode onto <html>, so the default look doesn't flash first.
 * If the stored skin no longer exists (e.g. the site owner disabled it), falls back to the default skin; if the stored scheme doesn't belong to the current skin, uses that skin's default scheme.
 * The available skins and schemes come from the appearance registry, see src/utils/skin.ts; syncing after page navigation is handled by src/scripts/theme-toggle.js.
 *
 * The album page has its own colors and only follows the skin; pass skinOnly there.
 */
import { defaultSchemes, skinSchemes } from '../../utils/skin';

interface Props {
    skinOnly?: boolean;
}

const { skinOnly = false } = Astro.props;
---

<script is:inline define:vars={{ skinOnly, defaultSchemes, skinSchemes }}>
    try {
        var root = document.documentElement;
        var skin = localStorage.getItem('skin');
        if (skin && Object.prototype.hasOwnProperty.call(skinSchemes, skin)) root.setAttribute('data-skin', skin);
        if (!skinOnly) {
            var current = root.getAttribute('data-skin');
            var allowed = skinSchemes[current] || [];
            var scheme = localStorage.getItem('colorScheme');
            if (!scheme || allowed.indexOf(scheme) === -1) scheme = defaultSchemes[current] || 'C';
            var isDark = localStorage.getItem('darkMode');
            root.setAttribute('data-theme', scheme);
            if (isDark === 'true' || (isDark === null && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                root.classList.add('dark');
            }
        }
    } catch (e) {}
</script>
